{
  "name": "insurance-portal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ng-journal",
  "sourceRoot": "apps/insurance-portal/src",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath.base}"],
      "options": {
        "outputPath": {
          "base": "dist/apps/insurance-portal"
        },
        "index": "apps/insurance-portal/src/index.html",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/insurance-portal/tsconfig.app.json",
        "assets": [
          "apps/insurance-portal/src/favicon.ico",
          "apps/insurance-portal/src/assets"
        ],
        "styles": [
          "apps/insurance-portal/src/styles.scss",
          "apps/insurance-portal/src/legacy-theme-variables.css",
          "node_modules/primeflex/primeflex.css"
        ],
        "scripts": [],
        "browser": "apps/insurance-portal/src/main.ts"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "insurance-portal:build:production"
        },
        "development": {
          "buildTarget": "insurance-portal:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "insurance-portal:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/insurance-portal/jest.config.ts",
        "tsConfig": "apps/insurance-portal/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "insurance-portal:build",
        "staticFilePath": "dist/apps/insurance-portal/browser",
        "spa": true
      }
    }
  }
}
